@* confirms the movie that is being deleted*@

@{
}

@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MovieEntry

<h2>Confirm Deletion</h2>
<h3>@Model.Title, @Model.Year</h3>
<form method="post">
    <input type="hidden" asp-for="MovieId">
    <button type="submit">Delete</button>
    <button class="btn btn-info" asp-controller="Home" asp-action="MoviesList">Cancel</button>
</form>