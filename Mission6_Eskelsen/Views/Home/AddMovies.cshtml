@model MovieEntry
@{
    Layout = "_Layout";
}

<h1>Add a New Movie to the Collection</h1>

@* form to accept the Title, Year, Director, Rating, category, edit status, who it is lent to, and Notes
runs the post in the home controller to send to database
follows data type information in MovieEntry model*@
<form method="post">
    <input asp-for="MovieId" type="hidden">
    <label asp-for="Title">Movie Title</label>
    <br>
    <input asp-for="Title">
    <br>
    <label asp-for="Year">Year</label>
    <br>
    <input asp-for="Year">
    <br>
    <label asp-for="Director">Director</label>
    <br>
    <input asp-for="Director">
    <br>
    <label asp-for="Rating">Rating</label>
    <br>
    @* a dropdown selector for MPAA Rating *@
    <select asp-for="Rating">
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <br>
    <label asp-for="CategoryId">Category</label>
    <br>
    <select asp-for="CategoryId">
        <option value="">Select a Category</option>
        @foreach (Category c in ViewBag.categories)
        {
            <option value="@c.CategoryId">@c.CategoryName</option>
        }
    </select>
    <br>
    <label asp-for="CopiedToPlex">Copied To Plex</label>
    <select asp-for="CopiedToPlex">
        <option value="0">No</option>
        <option value="1">Yes</option>
    </select>
    <br>
    <label asp-for="Edited">Edited</label>
    <br>
    @* a dropdown selector for edit status, returns with boolean values *@
    <select asp-for="Edited">
        <option value="0">No</option>
        <option value="1">Yes</option>
    </select>
    <br>
    <label asp-for="LentTo">Lent To</label>
    <br>
    <input asp-for="LentTo">
    <br>
    <label asp-for="Notes">Notes</label>
    <br>
    @* sets the Notes input to a character limit of 25*@
    <input asp-for="Notes">
    <br>
    <button type="submit">Add New Movie</button>

    <div asp-validation-summary="All"></div>
</form>



